# NexusGraph Environment Configuration
PROJECT_NAME="NexusGraph"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (SQLite default for zero-dependency demo deployment)
